-- FATIMABOWSMACRO V2
-- Transparent Purple Panel
-- Inventory:
-- 1 RPG | 2 Loverboard | 3 Taser
-- 4-7 Weapon Combo | 8 Gold Snow
-- 9 Blue Snow | 0 Brass
--
-- D-Pad Right = Loverboard activation
-- D-Pad Left = Brass

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")

local Player = Players.LocalPlayer
local Enabled = true
local Busy = false
local AutoRPG = false
local AimLock = false
local Speed = 2

local AUTO_RPG_DELAY = 0.8
local SNOW_DELAY = 0.09

local function pressKey(key)
    VIM:SendKeyEvent(true, key, false, game)
    task.wait(0.03)
    VIM:SendKeyEvent(false, key, false, game)
end

local function tapCenter()
    local camera = workspace.CurrentCamera
    if not camera then return end

    local size = camera.ViewportSize
    local x, y = size.X / 2, size.Y / 2

    VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
    VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
end

local slotKeys = {
    [0] = Enum.KeyCode.Zero,
    [1] = Enum.KeyCode.One,
    [2] = Enum.KeyCode.Two,
    [3] = Enum.KeyCode.Three,
    [4] = Enum.KeyCode.Four,
    [5] = Enum.KeyCode.Five,
    [6] = Enum.KeyCode.Six,
    [7] = Enum.KeyCode.Seven,
    [8] = Enum.KeyCode.Eight,
    [9] = Enum.KeyCode.Nine
}

local function equip(slot)
    local key = slotKeys[slot]
    if key then
        pressKey(key)
    end
end

local function returnToBoard()
    equip(2)
    task.wait(0.15)
    pressKey(Enum.KeyCode.DPadRight)
end

local function runMacro(callback)
    if not Enabled or Busy then return end
    Busy = true

    task.spawn(function()
        local ok, err = pcall(callback)
        if not ok then
            warn("[FatimaBowsMacro] " .. tostring(err))
        end
        Busy = false
    end)
end

-- REGULAR MACROS

local function RPGMacro()
    equip(1)
    tapCenter()
    task.wait(0.1)
    returnToBoard()
end

local function TaserMacro()
    equip(3)
    tapCenter()
    task.wait(0.1)
    returnToBoard()
end

local function SnowMacro()
    equip(8)
    tapCenter()
    task.wait(SNOW_DELAY)

    equip(9)
    tapCenter()
    task.wait(SNOW_DELAY)

    returnToBoard()
end

local function WeaponMacro()
    for slot = 4, 7 do
        equip(slot)
        tapCenter()
        task.wait(0.05 / Speed)
    end

    returnToBoard()
end

local function BoardMacro()
    returnToBoard()
end

local function BrassMacro()
    equip(0)
end

local function ReloadMacro()
    pressKey(Enum.KeyCode.X)
end

-- AUTO RPG
local function startAutoRPG()
    if AutoRPG then return end
    AutoRPG = true

    task.spawn(function()
        while AutoRPG and Enabled do
            if not Busy then
                Busy = true

                local ok, err = pcall(function()
                    equip(1)
                    tapCenter()
                    task.wait(0.15)
                    returnToBoard()
                end)

                if not ok then
                    warn(err)
                end

                Busy = false
            end

            task.wait(AUTO_RPG_DELAY)
        end
    end)
end

local function stopAutoRPG()
    AutoRPG = false
end

