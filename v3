Reopen.Visible = false

RPG.MouseButton1Click:Connect(function()
    runMacro(RPGMacro)
end)

Taser.MouseButton1Click:Connect(function()
    runMacro(TaserMacro)
end)

Snow.MouseButton1Click:Connect(function()
    runMacro(SnowMacro)
end)

Combo.MouseButton1Click:Connect(function()
    runMacro(WeaponMacro)
end)

Board.MouseButton1Click:Connect(function()
    runMacro(BoardMacro)
end)

Brass.MouseButton1Click:Connect(function()
    runMacro(BrassMacro)
end)

Reload.MouseButton1Click:Connect(function()
    if Enabled and not Busy then
        ReloadMacro()
    end
end)

AutoButton.MouseButton1Click:Connect(function()
    if not Enabled then return end

    if AutoRPG then
        stopAutoRPG()
        AutoButton.Text = "AUTO RPG: OFF"
    else
        startAutoRPG()
        AutoButton.Text = "AUTO RPG: ON"
    end
end)

AimButton.MouseButton1Click:Connect(function()
    AimLock = not AimLock
    AimButton.Text = AimLock
        and "AIM LOCK: ON (Placeholder)"
        or "AIM LOCK: OFF (Placeholder)"
end)

Toggle.MouseButton1Click:Connect(function()
    Enabled = not Enabled

    if not Enabled then
        stopAutoRPG()
    end

    Status.Text = Enabled
        and "Status: ENABLED"
        or "Status: DISABLED"

    Toggle.Text = Enabled
        and "Disable Macro"
        or "Enable Macro"

    if not Enabled then
        AutoButton.Text = "AUTO RPG: OFF"
    end
end)

Close.MouseButton1Click:Connect(function()
    Main.Visible = false
    Reopen.Visible = true
end)

Reopen.MouseButton1Click:Connect(function()
    Main.Visible = true
    Reopen.Visible = false
end)

-- DRAG PANEL

local dragging = false
local dragStart
local startPosition

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPosition = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

-- CONTROLLER SHORTCUTS

local shortcuts = {
    [Enum.KeyCode.ButtonL1] = RPGMacro,
    [Enum.KeyCode.ButtonR1] = TaserMacro,
    [Enum.KeyCode.ButtonY] = SnowMacro,
    [Enum.KeyCode.ButtonL3] = WeaponMacro,
    [Enum.KeyCode.DPadRight] = BoardMacro,
    [Enum.KeyCode.DPadLeft] = BrassMacro
}

UIS.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or not Enabled then return end

    local callback = shortcuts[input.KeyCode]

    if callback then
        runMacro(callback)
    elseif input.KeyCode == Enum.KeyCode.X
    or input.KeyCode == Enum.KeyCode.ButtonX then
        if not Busy then ReloadMacro() end
    end
end)

print("♡ FATIMABOWSMACRO V2 loaded!")
